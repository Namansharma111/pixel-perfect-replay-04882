# Backend Server Configuration
PORT=5000
NODE_ENV=development

# JWT & Session Secret Key
SESSION_SECRET=social-waale-cms-super-secret-key-2026-production

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Database file path (defaults to ./data/cms-store.json)
DATABASE_FILE=./data/cms-store.json

# File Upload Directory
UPLOAD_DIR=./uploads

# Instagram Downloader Provider Settings
DOWNLOADER_RATE_LIMIT_PER_MINUTE=60
